<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane fx:id="paneMain" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" onMouseClicked="#handleMouseClick" prefHeight="400.0" prefWidth="600.0" stylesheets="@main.css" xmlns="http://javafx.com/javafx/8.0.40" xmlns:fx="http://javafx.com/fxml/1" fx:controller="universite_paris8.iut.bak.timetowerdefense.controleur.ControleurJeu">
   <children>
      <Pane fx:id="backgroundPane" prefHeight="200.0" prefWidth="200.0" />
      <Pane fx:id="entityPane" prefHeight="200.0" prefWidth="200.0" />
      <Pane fx:id="effectPane" prefHeight="200.0" prefWidth="200.0">
         <children>
         </children>
      </Pane>

      <BorderPane fx:id="uiPane" focusTraversable="true" onKeyPressed="#gererTouches" pickOnBounds="false" prefHeight="200.0" prefWidth="200.0">
         <top>
            <HBox alignment="CENTER" spacing="30.0" styleClass="top-bar" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="labelPvBase" styleClass="stats-label" textFill="WHITE" />
                  <Label fx:id="labelVague" styleClass="stats-label" textFill="WHITE" />
                  <Label fx:id="labelArgent" styleClass="stats-label" textFill="GOLD" />
                  <Label fx:id="labelCompteurKill" styleClass="stats-label" textFill="RED" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </top>

         <right>
            <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
               <children>

                  <Pane fx:id="zoneStats" prefHeight="200.0" prefWidth="150.0" visible="false">
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </Pane>
               </children>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </VBox>
         </right>

         <left>
            <VBox alignment="TOP_LEFT" spacing="20.0" BorderPane.alignment="TOP_LEFT">
               <children>
                  <Button onAction="#togglePause" styleClass="side-button" text="PAUSE (P)" BorderPane.alignment="TOP_LEFT">
                     <BorderPane.margin>
                        <Insets left="10.0" top="20.0" />
                     </BorderPane.margin>
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                  </Button>
                  <Button onAction="#toggleGlossaire" styleClass="side-button" text="GLOSSAIRE (G)" BorderPane.alignment="TOP_LEFT">
                     <BorderPane.margin>
                        <Insets left="10.0" top="20.0" />
                     </BorderPane.margin>
                  </Button>
               </children>
            </VBox>
         </left>

         <bottom>
            <HBox fx:id="boutonBox" alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox alignment="CENTER" prefHeight="1.0" prefWidth="106.0">
                     <children>
                        <Button fx:id="tourUn" mnemonicParsing="false" onAction="#poseTour" styleClass="tour-button" userData="1" />
                        <Label fx:id="tourUnArgent" text="25" textFill="WHITE" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="3.0" prefWidth="106.0">
                     <children>
                        <Button fx:id="tourDeux" mnemonicParsing="false" onAction="#poseTour" styleClass="tour-button" userData="2" />
                        <Label fx:id="tourDeuxArgent" text="50" textFill="WHITE" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="1.0" prefWidth="106.0">
                     <children>
                        <Button fx:id="tourTrois" mnemonicParsing="false" onAction="#poseTour" styleClass="tour-button" userData="3" />
                        <Label fx:id="tourTroisArgent" text="150" textFill="WHITE" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="1.0" prefWidth="106.0">
                     <children>
                        <Button fx:id="tourQuatre" mnemonicParsing="false" onAction="#poseTour" styleClass="tour-button" userData="4" />
                        <Label fx:id="tourQuatreArgent" text="200" textFill="WHITE" />
                     </children>
                  </VBox>
                  <Button fx:id="ultButton" mnemonicParsing="false" onAction="#lancerUltime" text="ULTIME">
                     <font>
                        <Font name="DejaVu Sans Bold" size="16.0" />
                     </font>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="15.0" left="10.0" right="10.0" top="15.0" />
               </padding>
            </HBox>
         </bottom>
      </BorderPane>

      <Label fx:id="labelMessageSys" alignment="CENTER" mouseTransparent="true" text="">
         <font>
            <Font name="DejaVu Sans Bold" size="38.0" />
         </font>
      </Label>

      <ScrollPane fx:id="paneGlossaire" maxHeight="350.0" maxWidth="450.0" visible="false">
         <VBox fx:id="contenuGlossaire" alignment="TOP_LEFT" spacing="15.0">
         </VBox>
      </ScrollPane>

      <VBox fx:id="panePause" alignment="CENTER" spacing="25" visible="false">
         <children>
            <Label text="PAUSE" textFill="WHITE">
               <font>
                  <Font name="DejaVu Sans Bold" size="48.0" />
               </font>
            </Label>
            <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 10; -fx-padding: 20;">
               <VBox.margin>
                  <Insets bottom="15.0" />
               </VBox.margin>
               <children>
                  <Label style="-fx-font-weight: bold;" text="MUSIQUE" textFill="LIGHTGRAY" />
                  <HBox alignment="CENTER" spacing="15.0">
                     <Button fx:id="btnMusique" onAction="#toggleMuteMusique" styleClass="btn-audio" text="🔊" />
                     <Slider fx:id="sliderMusique" max="1.0" min="0.0" prefWidth="200.0" value="0.3" />
                  </HBox>

                  <Label style="-fx-font-weight: bold;" text="EFFETS SONORES" textFill="LIGHTGRAY">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
                  <HBox alignment="CENTER" spacing="15.0">
                     <Button fx:id="btnSfx" onAction="#toggleMuteSfx" styleClass="btn-audio" text="🔊🔊" />
                     <Slider fx:id="sliderSfx" max="1.0" min="0.0" prefWidth="200.0" value="0.4" />
                  </HBox>
               </children>
            </VBox>
            <Button onAction="#togglePause" styleClass="overlay-button, btn-reprendre" text="REPRENDRE" />
            <Button onAction="#recommencerPartie" styleClass="overlay-button, btn-recommencer" text="RECOMMENCER" />
         </children>
      </VBox>

      <VBox fx:id="paneGameOver" alignment="CENTER" spacing="20" visible="false">
         <children>
            <Label styleClass="game-over-title" text="GAME OVER" textFill="#e74c3c">
               <font>
                  <Font name="DejaVu Sans Bold" size="54.0" />
               </font>
            </Label>
            <Label fx:id="labelDetailGameOver" textFill="WHITE">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Button onAction="#recommencerPartie" styleClass="overlay-button, btn-recommencer" text="RECOMMENCER" />
         </children>
      </VBox>
   </children>
</StackPane>
