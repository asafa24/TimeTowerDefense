<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" onMouseClicked="#handleMouseClick" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="universite_paris8.iut.bak.timetowerdefense.controleur.ControleurJeu">
   <children>
      <Pane fx:id="backgroundPane" prefHeight="200.0" prefWidth="200.0" />
      <Pane fx:id="entityPane" prefHeight="200.0" prefWidth="200.0" />
      <Pane fx:id="effectPane" prefHeight="200.0" prefWidth="200.0" />

      <BorderPane focusTraversable="true" onKeyPressed="#gererTouches" fx:id="uiPane" pickOnBounds="false" prefHeight="200.0" prefWidth="200.0">

         <top>
            <HBox alignment="CENTER" spacing="30.0" style="-fx-background-color: rgba(0, 0, 0, 0.5);" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="labelPvBase"  textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                  <Label fx:id="labelVague"  textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                  <Label fx:id="labelArgent" textFill="GOLD" style="-fx-font-weight: bold; -fx-font-size: 14px;" />

               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </top>

         <bottom>
            <HBox alignment="CENTER" spacing="20.0" style="-fx-background-color: rgba(0, 0, 0, 0.5);" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="tourUn" mnemonicParsing="false" onAction="#poseDeTourUn" text="Tour 1 : Normale (50$)" />
                  <Button fx:id="tourDeux" mnemonicParsing="false" onAction="#poseDeTourDeux" text="Tour 2 : Cercle (150$)" />
                  <Button fx:id="tour3" mnemonicParsing="false" onAction="#poseDeTourTrois" text="Tour 3 (150$)" />
               </children>
               <padding>
                  <Insets bottom="15.0" left="10.0" right="10.0" top="15.0" />
               </padding>
            </HBox>
         </bottom>

      </BorderPane>
   </children>
</StackPane>