<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane fx:id="paneMain" stylesheets="@main.css" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" onMouseClicked="#handleMouseClick" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="universite_paris8.iut.bak.timetowerdefense.controleur.ControleurJeu">
   <children>
      <Pane fx:id="backgroundPane" prefHeight="200.0" prefWidth="200.0" />
      <Pane fx:id="entityPane" prefHeight="200.0" prefWidth="200.0" />
      <Pane fx:id="effectPane" prefHeight="200.0" prefWidth="200.0">
         <children>
         </children>
      </Pane>

      <BorderPane fx:id="uiPane" focusTraversable="true" onKeyPressed="#gererTouches" pickOnBounds="false" prefHeight="200.0" prefWidth="200.0">
         <top>
            <HBox styleClass="top-bar" alignment="CENTER" spacing="30.0" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="labelPvBase" styleClass="stats-label" textFill="WHITE" />
                  <Label fx:id="labelVague" styleClass="stats-label" textFill="WHITE" />
                  <Label fx:id="labelArgent" styleClass="stats-label" textFill="GOLD" />
                  <Label fx:id="labelCompteurKill" styleClass="stats-label" textFill="RED" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </top>

         <right>
            <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="ultButton" mnemonicParsing="false" onAction="#lancerUltime" text="ULTIME">
                     <font>
                        <Font name="DejaVu Sans Bold" size="16.0" />
                     </font>
                  </Button>

                  <Pane fx:id="zoneStats" prefHeight="200.0" prefWidth="150.0" visible="false">
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </Pane>
               </children>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </VBox>
         </right>

         <left>
            <VBox alignment="TOP_LEFT" spacing="20.0" BorderPane.alignment="TOP_LEFT">
               <children>
                  <Button styleClass="side-button" onAction="#togglePause" text="PAUSE (P)" BorderPane.alignment="TOP_LEFT">
                     <BorderPane.margin>
                        <Insets left="10.0" top="20.0" />
                     </BorderPane.margin>
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                  </Button>
                  <Button styleClass="side-button" onAction="#toggleGlossaire" text="GLOSSAIRE (G)" BorderPane.alignment="TOP_LEFT">
                     <BorderPane.margin>
                        <Insets left="10.0" top="20.0" />
                     </BorderPane.margin>
                  </Button>
               </children>
            </VBox>
         </left>

         <bottom>
            <HBox fx:id="boutonBox" alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox alignment="CENTER" prefHeight="1.0" prefWidth="106.0">
                     <children>
                        <Button fx:id="tourUn" styleClass="tour-button" mnemonicParsing="false" onAction="#poseTour" userData="1" />
                        <Label fx:id="tourUnArgent" text="25" textFill="WHITE" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="3.0" prefWidth="106.0">
                     <children>
                        <Button fx:id="tourDeux" styleClass="tour-button" mnemonicParsing="false" onAction="#poseTour" userData="2" />
                        <Label fx:id="tourDeuxArgent" text="50" textFill="WHITE" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="1.0" prefWidth="106.0">
                     <children>
                        <Button fx:id="tourTrois" styleClass="tour-button" mnemonicParsing="false" onAction="#poseTour" userData="3" />
                        <Label fx:id="tourTroisArgent" text="150" textFill="WHITE" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="1.0" prefWidth="106.0">
                     <children>
                        <Button fx:id="tourQuatre" styleClass="tour-button" mnemonicParsing="false" onAction="#poseTour" userData="4" />
                        <Label fx:id="tourQuatreArgent" text="200" textFill="WHITE" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="15.0" left="10.0" right="10.0" top="15.0" />
               </padding>
            </HBox>
         </bottom>
      </BorderPane>

      <Label fx:id="labelMessageSys" alignment="CENTER" mouseTransparent="true" text="">
         <font>
            <Font name="DejaVu Sans Bold" size="38.0" />
         </font>
      </Label>

      <ScrollPane fx:id="paneGlossaire" maxHeight="350.0" maxWidth="450.0" visible="false">
         <VBox fx:id="contenuGlossaire" alignment="TOP_LEFT" spacing="15.0">
         </VBox>
      </ScrollPane>

      <VBox fx:id="panePause" alignment="CENTER" spacing="25" visible="false">
         <children>
            <Label text="PAUSE" textFill="WHITE">
               <font>
                  <Font name="DejaVu Sans Bold" size="48.0" />
               </font>
            </Label>
            <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 10; -fx-padding: 20;">
               <VBox.margin>
                  <Insets bottom="15.0" />
               </VBox.margin>
               <children>
                  <Label text="MUSIQUE" textFill="LIGHTGRAY" style="-fx-font-weight: bold;"/>
                  <HBox alignment="CENTER" spacing="15.0">
                     <Button fx:id="btnMusique" text="🔊" onAction="#toggleMuteMusique" styleClass="btn-audio"/>
                     <Slider fx:id="sliderMusique" min="0.0" max="1.0" value="0.3" prefWidth="200.0"/>
                  </HBox>

                  <Label text="EFFETS SONORES" textFill="LIGHTGRAY" style="-fx-font-weight: bold;">
                     <VBox.margin>
                        <Insets top="10.0"/>
                     </VBox.margin>
                  </Label>
                  <HBox alignment="CENTER" spacing="15.0">
                     <Button fx:id="btnSfx" text="🔊" onAction="#toggleMuteSfx" styleClass="btn-audio"/>
                     <Slider fx:id="sliderSfx" min="0.0" max="1.0" value="0.4" prefWidth="200.0"/>
                  </HBox>
               </children>
            </VBox>
            <Button styleClass="overlay-button, btn-reprendre" onAction="#togglePause" text="REPRENDRE" />
            <Button styleClass="overlay-button, btn-recommencer" onAction="#recommencerPartie" text="RECOMMENCER" />
         </children>
      </VBox>

      <VBox fx:id="paneGameOver" alignment="CENTER" spacing="20" visible="false">
         <children>
            <Label styleClass="game-over-title" text="GAME OVER" textFill="#e74c3c">
               <font>
                  <Font name="DejaVu Sans Bold" size="54.0" />
               </font>
            </Label>
            <Label fx:id="labelDetailGameOver" textFill="WHITE">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Button styleClass="overlay-button, btn-recommencer" onAction="#recommencerPartie" text="RECOMMENCER" />
         </children>
      </VBox>
   </children>
</StackPane>