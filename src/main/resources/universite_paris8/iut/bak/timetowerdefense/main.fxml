<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.*?>
<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>


<StackPane fx:id="paneMain" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" onMouseClicked="#handleMouseClick" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="universite_paris8.iut.bak.timetowerdefense.controleur.ControleurJeu">
   <children>
      <Pane fx:id="backgroundPane" prefHeight="200.0" prefWidth="200.0" />
      <Pane fx:id="entityPane" prefHeight="200.0" prefWidth="200.0" />
      <Pane fx:id="effectPane" prefHeight="200.0" prefWidth="200.0" />

      <BorderPane fx:id="uiPane" focusTraversable="true" onKeyPressed="#gererTouches" pickOnBounds="false" prefHeight="200.0" prefWidth="200.0">

         <top>
            <HBox alignment="CENTER" spacing="30.0" style="-fx-background-color: rgba(0, 0, 0, 0.5);" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="labelPvBase" style="-fx-font-weight: bold; -fx-font-size: 14px;" textFill="WHITE" />
                  <Label fx:id="labelVague" style="-fx-font-weight: bold; -fx-font-size: 14px;" textFill="WHITE" />
                  <Label fx:id="labelArgent" style="-fx-font-weight: bold; -fx-font-size: 14px;" textFill="GOLD" />
                  <Label fx:id="labelCompteurKill" style="-fx-font-weight: bold; -fx-font-size: 14px;" textFill="RED" />


               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </top>

         <bottom>
            <HBox fx:id="boutonBox" alignment="CENTER" spacing="10.0" style="-fx-background-color: rgba(0, 0, 0, 0.5);" BorderPane.alignment="CENTER">
               <children>
                  <Button mnemonicParsing="false" text="cacher" />
                  <VBox alignment="CENTER" prefHeight="1.0" prefWidth="106.0">
                     <children>
                        <Button fx:id="tourQuatre" mnemonicParsing="false" onAction="#poseDeTourQuatre" style="-fx-background-color: transparent; -fx-border-color: transparent;" />
                        <Label id="tourQuatreArgent" text="25" textFill="WHITE" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="1.0" prefWidth="106.0">
                     <children>
      
                        <Button fx:id="tourUn" mnemonicParsing="false" onAction="#poseDeTourUn" style="-fx-background-color: transparent; -fx-border-color: transparent;" />
                        <Label id="tourUnArgent" text="50" textFill="WHITE" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="3.0" prefWidth="106.0">
                     <children>
                        <Button fx:id="tourDeux" mnemonicParsing="false" onAction="#poseDeTourDeux" style="-fx-background-color: transparent; -fx-border-color: transparent;" />
                        <Label id="tourDeuxArgent" text="150" textFill="WHITE" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="1.0" prefWidth="106.0">
                     <children>
                        <Button fx:id="tourTrois" mnemonicParsing="false" onAction="#poseDeTourTrois" style="-fx-background-color: transparent; -fx-border-color: transparent;" />
                        <Label id="tourTroisArgent" text="150" textFill="WHITE" />
                     </children>
                  </VBox>



               </children>
               <padding>
                  <Insets bottom="15.0" left="10.0" right="10.0" top="15.0" />
               </padding>
            </HBox>
         </bottom>
         <right>
            <Button fx:id="ultButton" mnemonicParsing="false" onAction="#lancerUltime" text="ULTIME" BorderPane.alignment="CENTER">
               <font>
                  <Font name="DejaVu Sans Bold" size="13.0" />
               </font>
            </Button>
         </right>

      </BorderPane>
   </children>
</StackPane>
