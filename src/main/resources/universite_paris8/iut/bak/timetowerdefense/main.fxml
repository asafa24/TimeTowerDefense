<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.*?>
<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane fx:id="paneMain" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" onMouseClicked="#handleMouseClick" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8.0.40" xmlns:fx="http://javafx.com/fxml/1" fx:controller="universite_paris8.iut.bak.timetowerdefense.controleur.ControleurJeu">
   <children>
      <Pane fx:id="backgroundPane" prefHeight="200.0" prefWidth="200.0" />
      <Pane fx:id="entityPane" prefHeight="200.0" prefWidth="200.0" />
      <Pane fx:id="effectPane" prefHeight="200.0" prefWidth="200.0">
         <children>

         </children></Pane>

            <BorderPane fx:id="uiPane" focusTraversable="true" onKeyPressed="#gererTouches" pickOnBounds="false" prefHeight="200.0" prefWidth="200.0">

               <top>
            <HBox alignment="CENTER" spacing="30.0" style="-fx-background-color: rgba(0, 0, 0, 0.5);" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="labelPvBase" style="-fx-font-weight: bold; -fx-font-size: 14px;" textFill="WHITE" />
                  <Label fx:id="labelVague" style="-fx-font-weight: bold; -fx-font-size: 14px;" textFill="WHITE" />
                  <Label fx:id="labelArgent" style="-fx-font-weight: bold; -fx-font-size: 14px;" textFill="GOLD" />
                  <Label fx:id="labelCompteurKill" style="-fx-font-weight: bold; -fx-font-size: 14px;" textFill="RED" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </top>

               <right>
            <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="ultButton" mnemonicParsing="false" onAction="#lancerUltime" text="ULTIME">
                     <font>
                        <Font name="DejaVu Sans Bold" size="13.0" />
                     </font>
                  </Button>

                        <Pane fx:id="zoneStats" prefHeight="200.0" prefWidth="150.0" visible="false">
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </Pane>
               </children>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </VBox>
         </right>
               <left>
                  <Button text="GLOSSAIRE (G)" onAction="#toggleGlossaire" style="-fx-background-color: rgba(0, 0, 0, 0.5); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" BorderPane.alignment="TOP_LEFT">
                     <BorderPane.margin>
                        <Insets top="10.0" left="10.0" />
                     </BorderPane.margin>
                  </Button>
               </left>

               <bottom>
            <HBox fx:id="boutonBox" alignment="CENTER" spacing="10.0" style="-fx-background-color: rgba(0, 0, 0, 0.5);" BorderPane.alignment="CENTER">
               <children>

                        <VBox alignment="CENTER" prefHeight="1.0" prefWidth="106.0">
                     <children>
      
                              <Button fx:id="tourUn" mnemonicParsing="false" userData="1" onAction="#poseTour" style="-fx-background-color: transparent; -fx-border-color: transparent;" />
                        <Label fx:id="tourUnArgent" text="25" textFill="WHITE" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="3.0" prefWidth="106.0">
                     <children>
                        <Button fx:id="tourDeux" mnemonicParsing="false" userData="2" onAction="#poseTour" style="-fx-background-color: transparent; -fx-border-color: transparent;" />
                        <Label fx:id="tourDeuxArgent" text="50" textFill="WHITE" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="1.0" prefWidth="106.0">
                     <children>
                        <Button fx:id="tourTrois" mnemonicParsing="false" userData="3" onAction="#poseTour" style="-fx-background-color: transparent; -fx-border-color: transparent;" />
                        <Label fx:id="tourTroisArgent" text="150" textFill="WHITE" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="1.0" prefWidth="106.0">
                     <children>
                        <Button fx:id="tourQuatre" mnemonicParsing="false" userData="4" onAction="#poseTour" style="-fx-background-color: transparent; -fx-border-color: transparent;" />
                        <Label fx:id="tourQuatreArgent" text="200" textFill="WHITE" />
                     </children>
                  </VBox>

                     </children>
               <padding>
                  <Insets bottom="15.0" left="10.0" right="10.0" top="15.0" />
               </padding>
            </HBox>
         </bottom>

            </BorderPane>
      <Label fx:id="labelMessageSys" alignment="CENTER" mouseTransparent="true" text=""
             style="-fx-effect: dropshadow(one-pass-box, black, 8, 1.0, 0, 0);">
         <font>
            <Font name="DejaVu Sans Bold" size="38.0" />
         </font>
      </Label>
      <ScrollPane fx:id="paneGlossaire" visible="false" maxWidth="450.0" maxHeight="350.0" style="-fx-background-color: transparent; -fx-background: rgba(0,0,0,0.85); -fx-padding: 10;">
         <VBox fx:id="contenuGlossaire" spacing="15.0" alignment="TOP_LEFT">
         </VBox>
      </ScrollPane>

      <VBox fx:id="panePause" alignment="CENTER" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.75);" spacing="25">
         <children>
            <Label text="PAUSE" textFill="WHITE">
               <font>
                  <Font name="DejaVu Sans Bold" size="48.0" />
               </font>
            </Label>
            <Button text="REPRENDRE" onAction="#togglePause" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 20; -fx-padding: 10 30 10 30; -fx-cursor: hand;" />
            <Button text="RECOMMENCER" onAction="#recommencerPartie" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 20; -fx-padding: 10 30 10 30; -fx-cursor: hand;" />
         </children>
      </VBox>

      <VBox fx:id="paneGameOver" alignment="CENTER" visible="false" style="-fx-background-color: rgba(15, 17, 26, 0.95);" spacing="20">
         <children>
            <Label text="GAME OVER" textFill="#e74c3c" style="-fx-effect: dropshadow(gaussian, rgba(231, 76, 60, 0.4), 15, 0.5, 0, 0);">
               <font>
                  <Font name="DejaVu Sans Bold" size="54.0" />
               </font>
            </Label>
            <Label fx:id="labelDetailGameOver" textFill="WHITE">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Button text="RECOMMENCER" onAction="#recommencerPartie" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 20; -fx-padding: 10 30 10 30; -fx-cursor: hand;" />
         </children>
      </VBox>
   </children>
</StackPane>
